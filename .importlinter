# --- Import Linter configuration ---------------------------------------------
#
# Enforces the dependency rule of the layered architecture. Ruff and mypy see
# nothing wrong with a domain module importing a database driver; this is the
# tool that does.
#
# Related files:
#   - .ruff.toml               bans relative imports, which would hide violations
#   - scripts/import_contracts.py  the allow-list contract type used below
#
# Recipes: `just lint`, `just check`.
#
# root_package must be renamed together with the package itself.

[importlinter]
root_package = kop
# Required by the allow-list contracts below: without it external packages are
# not part of the graph, and an import of one cannot be seen at all.
include_external_packages = True
# Resolved from the repository root, which Import Linter puts on sys.path.
contract_types =
    allowed_external_imports: scripts.import_contracts.AllowedExternalImportsContract


# --- Layer contract ----------------------------------------------------------
# Dependencies may only point downwards. Layers listed on the same line are
# siblings: presentation and infrastructure may not import each other.
#
#   main            composition root, may import everything below
#   presentation    inbound adapters (HTTP, CLI)
#   infrastructure  outbound adapters (database, brokers, external APIs)
#   application     use cases, orchestrates the domain through ports
#   domain          entities and business rules, imports nothing of ours
#
# A contract passes trivially while the layers are empty. It only starts
# protecting anything once real modules exist.

[importlinter:contract:layers]
name = Clean Architecture layers
type = layers
containers =
    kop
layers =
    main
    presentation | infrastructure
    application
    domain


# --- Framework-free core -----------------------------------------------------
# The layer contract only orders our own packages; it has nothing to say about
# a domain entity importing SQLAlchemy. These two close that gap.
#
# Allow-lists rather than deny-lists: the standard library is always allowed,
# every other external package only when named here. A new dependency is
# therefore off limits to the core until someone decides otherwise — nothing
# has to remember to forbid it.

# Entities and rules: the standard library, plus typing backports.
[importlinter:contract:domain-purity]
name = Domain imports only the standard library
type = allowed_external_imports
source_modules =
    kop.domain
allowed_modules =
    typing_extensions

# Use cases: pydantic for DTOs and structlog for logging, never a driver, a web
# framework or the container.
[importlinter:contract:application-purity]
name = Application imports only the standard library, pydantic and structlog
type = allowed_external_imports
source_modules =
    kop.application
allowed_modules =
    pydantic
    structlog
    typing_extensions
