# --- Git attributes ----------------------------------------------------------
#
# Line ending normalisation, diff behaviour and archive contents.
#
# Related files:
#   - .editorconfig            same line ending rule, for editors
#   - .pre-commit-config.yaml  mixed-line-ending --fix=lf enforces it on commit
#
# Note: this format has no inline comments — a comment occupies a whole line.


# --- Line endings ------------------------------------------------------------
# Everything is stored and checked out with LF, including on Windows.

* text=auto eol=lf


# --- Diff drivers ------------------------------------------------------------
# Gives Python hunks a meaningful header (the enclosing def or class).

*.py text diff=python


# --- Binary files ------------------------------------------------------------
# Never normalise or attempt to merge these.

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary


# --- GitHub classification ---------------------------------------------------
# Lock files are generated: GitHub collapses them in diffs and leaves them out
# of the language statistics. A textual diff is deliberately kept — lock
# changes occasionally need to be read by a human.

uv.lock linguist-generated=true
frontend/package-lock.json linguist-generated=true
docs/** linguist-documentation=true


# --- Archive contents --------------------------------------------------------
# Excluded from the tarballs GitHub generates for a tag (git archive). This has
# no effect on the wheel or the sdist: the build backend selects those files
# itself.

.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.pre-commit-config.yaml export-ignore
.cz.toml export-ignore
.changelog.md.j2 export-ignore
tests/ export-ignore
