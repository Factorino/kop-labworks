# --- Compose variables (template) --------------------------------------------
#
# Copied to .config/compose.env by `just init`. Ignored by git — only this
# *.example template is tracked.
#
# Not application configuration. This file exists because compose needs a few
# values of its own before any container starts: what the database and broker
# containers bootstrap themselves with, and the host side of published ports.
#
# One set of values for both environments of the stack: `just up local` and
# `just up development` start the same services with the same credentials;
# local only publishes their ports.
#
# It is passed as `--env-file` by the recipes in the justfile, rather than left
# at docker/.env, so that everything to fill in is under .config/.
#
# Related files:
#   - docker/docker-compose.yml        the credentials below
#   - docker/docker-compose.local.yml  the ports below


# --- PostgreSQL --------------------------------------------------------------
# Read when the container initialises an empty volume. The password is not
# here: it is a Docker secret, taken from .secrets/pg_pwd.txt.

POSTGRES_USER=kop
POSTGRES_DB=kop
POSTGRES_PORT=54320


# --- Redis -------------------------------------------------------------------

REDIS_PORT=56379


# --- RabbitMQ ----------------------------------------------------------------
# RabbitMQ has no file form for its password and takes it from the
# environment.

RABBITMQ_USER=kop
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_PORT=56720
RABBITMQ_UI_PORT=15672
