# --- Compose variables (template) --------------------------------------------
#
# Copied to .config/compose.env by `just init`. Ignored by git — only this
# *.example template is tracked.
#
# Not application configuration. This file exists because compose needs a few
# values of its own before any container starts:
#
#   - the image tag and the version stamped into its labels;
#   - the host side of a published port;
#   - what the database and broker containers bootstrap themselves with.
#
# It is passed as `--env-file` by the recipes in the justfile, rather than left
# at docker/.env, so that everything to fill in is under .config/.
#
# Related files:
#   - docker/docker-compose.yml      interpolates the application stack values
#   - docker/docker-compose.dev.yml  interpolates DEV_*
#
# Recipes: `just up`, `just dev-up`, `just build`.


# --- Image -------------------------------------------------------------------
# The tag `just build` produces, and the version stamped into the image labels.
# `just build` fills the commit and the build date from git itself.

APP_VERSION=local


# --- Application stack -------------------------------------------------------
# Read by the database and broker containers when they initialise an empty
# volume. The postgres password is not here: it is a Docker secret, taken from
# .secrets/pg_pwd.txt. RabbitMQ has no file form and takes its password from
# the environment.

POSTGRES_USER=kop
POSTGRES_DB=kop

RABBITMQ_USER=kop
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_UI_PORT=15672


# --- Development dependencies ------------------------------------------------
# What `just dev-up` starts for processes running on the host. Published on
# 127.0.0.1 only; the ports are not the defaults, so they do not collide with a
# Postgres, Redis or RabbitMQ already installed on the host.

DEV_PG_PORT=54320
DEV_PG_USER=kop
DEV_PG_DB=kop
DEV_PG_PASSWORD=kop-local-only

DEV_REDIS_PORT=56379

DEV_RABBITMQ_PORT=56720
DEV_RABBITMQ_UI_PORT=15673
DEV_RABBITMQ_USER=kop
DEV_RABBITMQ_PASSWORD=kop-local-only
